# ============================================================
# MyClassboard Games Platform - Environment Configuration Template
# Copy this file to .env and configure your local settings
# ============================================================

# ============================================================
# GEMINI API CONFIGURATION
# ============================================================
# Google Gemini API Key for AI-powered question & activity generation
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# FLASK CONFIGURATION
# ============================================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py

# ============================================================
# SERVER CONFIGURATION
# ============================================================
WEB_PORT=8000
API_PORT=5000
API_HOST=0.0.0.0

# ============================================================
# DATABASE CONFIGURATION - POSTGRESQL
# ============================================================
DATABASE_URL=postgresql+psycopg2://myclassboard_user:password@localhost:5432/myclassboard_games
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myclassboard_games
DB_USER=myclassboard_user
DB_PASSWORD=your_secure_password

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=False

# ============================================================
# CORS & LOGGING CONFIGURATION
# ============================================================
CORS_ORIGINS=http://localhost:8000,http://localhost:5000,http://127.0.0.1:8000
LOG_LEVEL=INFO
LOG_FILE=app.log

# ============================================================
# FEATURE FLAGS
# ============================================================
ENABLE_AI_CONTENT_GENERATION=True
ENABLE_AUDIO_SCRIPTS=True
ENABLE_ADAPTIVE_DIFFICULTY=True
ENABLE_POINTS_TRACKING=True
ENABLE_AUDIO_FEEDBACK=True

# ============================================================
# SESSION CONFIGURATION
# ============================================================
SESSION_TIMEOUT=3600
MAX_STUDENTS_PER_CLASS=50
MAX_GAMES_PER_SKILL=10

# ============================================================
# AUDIO FEEDBACK SETTINGS
# ============================================================
AUDIO_ENABLED=True
CORRECT_SOUND_FREQUENCY=800
WRONG_SOUND_FREQUENCY=400
VOLUME_LEVEL=0.5

